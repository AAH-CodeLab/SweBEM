!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAM ===========

EnergyManagementSystem:Program,
    SET_Back_Space_Light_EMS_Program,  !- Name
    SET Back_Space_LSr_IP=0.093*Back_Space_LSr/Back_Space_Area,  !- Program Line 1
    IF (Back_Space_Occ_Sensor <= 0) && (Back_Space_LSr_IP >= 0.02),  !- Program Line 2
    SET Back_Space_Light_Actuator = 0.02*Back_Space_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Back_Space_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Core_Retail_Light_EMS_Program,  !- Name
    SET Core_Retail_LSr_IP=0.093*Core_Retail_LSr/Core_Retail_Area,  !- Program Line 1
    IF (Core_Retail_Occ_Sensor <= 0) && (Core_Retail_LSr_IP >= 0.02),  !- Program Line 2
    SET Core_Retail_Light_Actuator = 0.02*Core_Retail_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Core_Retail_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Point_Of_Sale_Light_EMS_Program,  !- Name
    SET Point_Of_Sale_LSr_IP=0.093*Point_Of_Sale_LSr/Point_Of_Sale_Area,  !- Program Line 1
    IF (Point_Of_Sale_Occ_Sensor <= 0) && (Point_Of_Sale_LSr_IP >= 0.02),  !- Program Line 2
    SET Point_Of_Sale_Light_Actuator = 0.02*Point_Of_Sale_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Point_Of_Sale_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Front_Retail_Light_EMS_Program,  !- Name
    SET Front_Retail_LSr_IP=0.093*Front_Retail_LSr/Front_Retail_Area,  !- Program Line 1
    IF (Front_Retail_Occ_Sensor <= 0) && (Front_Retail_LSr_IP >= 0.02),  !- Program Line 2
    SET Front_Retail_Light_Actuator = 0.02*Front_Retail_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Front_Retail_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Front_Entry_Light_EMS_Program,  !- Name
    SET Front_Entry_LSr_IP=0.093*Front_Entry_LSr/Front_Entry_Area,  !- Program Line 1
    IF (Front_Entry_Occ_Sensor <= 0) && (Front_Entry_LSr_IP >= 0.02),  !- Program Line 2
    SET Front_Entry_Light_Actuator = 0.02*Front_Entry_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Front_Entry_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    OA_BASED_OPTIMUM_START_EMS_Program,  !- Name
    IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && OAT<23.9 && OAT>1.7,  !- Program Line 1
    SET CLGSETP_SCH_Actuator = 29.4,  !- Program Line 2
    SET HTGSETP_SCH_Actuator = 15.6,  !- A4
    ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && OAT<23.9 && OAT>1.7,  !- A5
    SET CLGSETP_SCH_Actuator = 29.4,  !- A6
    SET HTGSETP_SCH_Actuator = 15.6,  !- A7
    ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && OAT<23.9 && OAT>1.7,  !- A8
    SET CLGSETP_SCH_Actuator = 29.4,  !- A9
    SET HTGSETP_SCH_Actuator = 15.6,  !- A10
    ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && OAT<23.9 && OAT>1.7,  !- A11
    SET CLGSETP_SCH_Actuator = 29.4,  !- A12
    SET HTGSETP_SCH_Actuator = 15.6,  !- A13
    ELSE,                    !- A14
    SET CLGSETP_SCH_Actuator = NULL,  !- A15
    SET HTGSETP_SCH_Actuator = NULL,  !- A16
    ENDIF;                   !- A17

EnergyManagementSystem:Program,
    FrontEntry_HeaterControl,!- Name
    SET OAT_F = (OAT_F*1.8)+32,  !- Program Line 1
    IF OAT_F > 45,           !- Program Line 2
    SET FrontEntry_Coil = 0, !- A4
    SET FrontEntry_Fan = 0,  !- A5
    ELSE,                    !- A6
    SET FrontEntry_Coil = 1, !- A7
    SET FrontEntry_Fan = 1,  !- A8
    ENDIF;                   !- A9


