    PV_module,               !- Name
    5,                       !- PVWatts Version
    14815.5,                 !- DC System Capacity {W}
    Premium,                 !- Module Type
    FixedOpenRack,           !- Array Type
    0.113,                   !- System Losses
    TiltAzimuth,             !- Array Geometry Type
    0,                       !- Tilt Angle {deg}
    180;                     !- Azimuth Angle {deg}


