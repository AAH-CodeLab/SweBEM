    SET_Zone2_Fine_Storage_Light_EMS_Program;  !- Program Name 1

EnergyManagementSystem:ProgramCallingManager,
    SET_Zone3_Bulk_Storage_Light_EMS_Program_Prog_Manager,  !- Name
    BeginTimestepBeforePredictor,  !- EnergyPlus Model Calling Point
    SET_Zone3_Bulk_Storage_Light_EMS_Program;  !- Program Name 1


!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAM ===========

EnergyManagementSystem:Program,
    SET_Zone1_Office_Light_EMS_Program,  !- Name
    SET Zone1_Office_LSr_IP=0.093*Zone1_Office_LSr/Zone1_Office_Area,  !- Program Line 1
    IF (Zone1_Office_Occ_Sensor <= 0) && (Zone1_Office_LSr_IP >= 0.02),  !- Program Line 2
    SET Zone1_Office_Light_Actuator = 0.02*Zone1_Office_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Zone1_Office_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Zone2_Fine_Storage_Light_EMS_Program,  !- Name
    SET Zone2_Fine_Storage_LSr_IP=0.093*Zone2_Fine_Storage_LSr/Zone2_Fine_Storage_Area,  !- Program Line 1
    IF (Zone1_Office_Occ_Sensor <= 0) && (Zone2_Fine_Storage_LSr_IP >= 0.02),  !- Program Line 2
    SET Zone2_Fine_Storage_Light_Actuator = 0.02*Zone2_Fine_Storage_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Zone2_Fine_Storage_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7

EnergyManagementSystem:Program,
    SET_Zone3_Bulk_Storage_Light_EMS_Program,  !- Name
    SET Zone3_Bulk_Storage_LSr_IP=0.093*Zone3_Bulk_Storage_LSr/Zone3_Bulk_Storage_Area,  !- Program Line 1
    IF (Zone1_Office_Occ_Sensor <= 0) && (Zone3_Bulk_Storage_LSr_IP >= 0.02),  !- Program Line 2
    SET Zone3_Bulk_Storage_Light_Actuator = 0.02*Zone3_Bulk_Storage_Area/0.09290304,  !- A4
    ELSE,                    !- A5
    SET Zone3_Bulk_Storage_Light_Actuator = NULL,  !- A6
    ENDIF;                   !- A7


